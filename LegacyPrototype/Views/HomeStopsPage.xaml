<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="transitrack.Views.HomeStopsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F7F3E7"
    Padding="12">

    <VerticalStackLayout Spacing="12">

        <!-- Barre de recherche : grid à 2 colonnes pour une icône bien alignée -->
        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Start" Margin="0,4">
            <Entry x:Name="SearchEntry"
                   Placeholder="Rechercher une ligne ou un arrêt"
                   VerticalOptions="Center"
                   HeightRequest="40"
                   BackgroundColor="White"
                   CornerRadius="8"
                   Padding="12,8"
                   Grid.Column="0" />

            <!-- Bouton icône aligné proprement à droite -->
            <Button Text="🔍"
                    Grid.Column="1"
                    WidthRequest="44"
                    HeightRequest="40"
                    VerticalOptions="Center"
                    Margin="8,0,0,0"
                    BackgroundColor="#ffffff"
                    Clicked="OnSearchClicked" />
        </Grid>

        <!-- Contenu principal (liste d'arrêts) -->
        <CollectionView x:Name="StopsCollection" VerticalOptions="FillAndExpand">
            <!-- ItemsSource + templates à définir selon votre VM -->
        </CollectionView>

    </VerticalStackLayout>
</ContentPage><?xml version="1.0" encoding="utf-8" ?>
