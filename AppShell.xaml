<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TransiTrack.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:home="clr-namespace:TransiTrack.Views.Home"
    xmlns:rep="clr-namespace:TransiTrack.Views.Report"
    xmlns:drv="clr-namespace:TransiTrack.Views.Driver"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Carte Direct" Icon="icon_map.png">
            <ShellContent Route="HomePage" ContentTemplate="{DataTemplate home:HomePage}" />
        </Tab>
        <Tab Title="Signalement" Icon="icon_alert.png">
            <ShellContent Route="ReportPage" ContentTemplate="{DataTemplate rep:ReportPage}" />
        </Tab>
        <Tab Title="Espace Chauffeur" Icon="icon_bus.png">
            <ShellContent Route="DriverPage" ContentTemplate="{DataTemplate drv:DriverPage}" />
        </Tab>
    </TabBar>
</Shell>