<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TransiTrack.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette Couleurs TransiTrack -->
            <Color x:Key="PrimaryColor">#1A73E8</Color>
            <Color x:Key="PrimaryDark">#1557B0</Color>
            <Color x:Key="SecondaryColor">#34A853</Color>
            <Color x:Key="BackgroundColor">#F8F9FA</Color>
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#202124</Color>
            <Color x:Key="TextSecondary">#5F6368</Color>
            <Color x:Key="DangerColor">#EA4335</Color>
            <Color x:Key="WarningColor">#FBBC04</Color>
            <Color x:Key="BorderColor">#E0E0E0</Color>

            <!-- Styles communs -->
            <Style TargetType="Button" x:Key="PrimaryButtonStyle">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style TargetType="Entry" x:Key="StandardEntryStyle">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="HeightRequest" Value="46" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>