<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="transitrack.Views.AddReportPage"
             BackgroundColor="#F6F1E4">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="18,24,18,28">

            <Label Text="‹ Signaler un passage" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />

            <!-- 1. Arrêt -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="1. Arrêt" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Rond-point Deïdo" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Changer" FontSize="13" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 2. Ligne -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="2. Ligne" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                    <HorizontalStackLayout Spacing="10">
                        <Border BackgroundColor="#0F766E" StrokeShape="RoundRectangle 8" Padding="18,8">
                            <Label Text="L12" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="14" />
                        </Border>
                        <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 8" Padding="18,8">
                            <Label Text="L7" TextColor="#475569" FontAttributes="Bold" FontSize="14" />
                        </Border>
                        <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 8" Padding="18,8">
                            <Label Text="L3" TextColor="#475569" FontAttributes="Bold" FontSize="14" />
                        </Border>
                    </HorizontalStackLayout>
                    <Label Text="Ligne 12 vers Akwa" FontSize="13" TextColor="#475569" />
                </VerticalStackLayout>
            </Border>

            <!-- 3. Heure du passage -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="3. Heure du passage" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Maintenant 08:43" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Modifier" FontSize="13" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Bannière Connexion Figma -->
            <Border BackgroundColor="#F0FDFA" Stroke="#CCFBF1" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="14">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Connectez-vous pour contribuer" FontSize="12" TextColor="#0F766E" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Se connecter ›" FontSize="12" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoToAuthClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <Label Text="Votre signalement expire après 20 minutes." FontSize="12" TextColor="#64748B" HorizontalOptions="Center" />

            <!-- Confirmer le passage -->
            <Button Text="Confirmer le passage" BackgroundColor="#0F766E" TextColor="#FFFFFF" 
                    FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Clicked="OnConfirmReportClicked" />

            <Label Text="Bouton désactivé tant qu'aucune ligne n'est choisie" FontSize="11" TextColor="#94A3B8" HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>