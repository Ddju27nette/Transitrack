<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransiTrack.ViewModels"
             xmlns:models="clr-namespace:TransiTrack.Models"
             x:Class="TransiTrack.Views.Favorites.FavoritesPage"
             x:DataType="vm:FavoritesViewModel"
             Title="Mes Favoris"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto,*" Padding="16">
        <Label Text="Arrêts enregistrés" FontSize="18" FontAttributes="Bold" Margin="0,0,0,12" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Favorites}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BusStop">
                    <Border Margin="0,0,0,10" Padding="14" StrokeShape="RoundRectangle 12" BackgroundColor="White" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=SelectStopCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="40, *, Auto">
                            <Label Text="⭐" FontSize="22" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Padding="10,0">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Description}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="➔" FontSize="18" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>