<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransiTrack.ViewModels"
             x:Class="TransiTrack.Views.Driver.DriverPage"
             Title="Espace Chauffeur"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border BackgroundColor="#E8F0FE" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Prise de service Chauffeur" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource PrimaryColor}" />
                    <Label Text="Renseignez le matricule de votre véhicule pour émettre votre position aux usagers et régulateurs." 
                           FontSize="13" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Agence de transport" FontAttributes="Bold" />
            <Border Stroke="#DEE2E6" StrokeShape="RoundRectangle 10" Padding="10,0" BackgroundColor="White">
                <Picker ItemsSource="{Binding Agencies}" SelectedItem="{Binding SelectedAgency}" HeightRequest="46" />
            </Border>

            <Label Text="Matricule du véhicule" FontAttributes="Bold" />
            <Border Stroke="#DEE2E6" StrokeShape="RoundRectangle 10" Padding="12,2" BackgroundColor="White">
                <Entry Placeholder="Ex: LT-458-EB" Text="{Binding Registration}" HeightRequest="46" />
            </Border>

            <Label Text="Ligne desservie" FontAttributes="Bold" />
            <Border Stroke="#DEE2E6" StrokeShape="RoundRectangle 10" Padding="10,0" BackgroundColor="White">
                <Picker ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" HeightRequest="46" />
            </Border>

            <!-- Statut de l'émission -->
            <Border Margin="0,10,0,0" Padding="16" StrokeShape="RoundRectangle 12" BackgroundColor="White" StrokeThickness="0">
                <Label Text="{Binding StatusText}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
            </Border>

            <Button Text="{Binding ActionBtnText}" Command="{Binding ToggleTripCommand}" 
                    Style="{StaticResource PrimaryBtnStyle}" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>