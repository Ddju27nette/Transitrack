<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransiTrack.ViewModels"
             x:Class="TransiTrack.Views.Driver.DriverPage"
             x:DataType="vm:DriverViewModel"
             Title="Espace Chauffeur">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="16">

            <!-- 1. ÉCRAN DE CONNEXION CHAUFFEUR (Si non connecté) -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsNotAuthenticated}">
                <Label Text="Portail Conducteurs" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="Connectez-vous pour diffuser la position de votre véhicule." TextColor="Gray" HorizontalOptions="Center" HorizontalTextAlignment="Center" />

                <Entry Placeholder="Code Chauffeur ou Matricule" Text="{Binding DriverCode}" />
                <Entry Placeholder="Mot de passe" IsPassword="True" Text="{Binding Password}" />

                <Button Text="Se connecter" 
                        Command="{Binding LoginDriverCommand}"
                        BackgroundColor="#2E7D32" 
                        TextColor="White" />
            </VerticalStackLayout>

            <!-- 2. TABLEAU DE BORD DE COURSE (Si connecté) -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding IsAuthenticated}">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Session Chauffeur Active" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Button Grid.Column="1" Text="Déconnexion" Command="{Binding LogoutDriverCommand}" BackgroundColor="#D32F2F" TextColor="White" HeightRequest="36" />
                </Grid>

                <Label Text="Agence :" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding Agencies}" SelectedItem="{Binding SelectedAgency}" />

                <Label Text="Ligne :" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" />

                <Label Text="Matricule du Bus :" FontAttributes="Bold" />
                <Entry Text="{Binding Registration}" Placeholder="Ex: LT-450-AA" />

                <Frame BackgroundColor="#F5F5F5" BorderColor="#CCCCCC" CornerRadius="8" Padding="12">
                    <Label Text="{Binding StatusText}" FontAttributes="Bold" HorizontalOptions="Center" />
                </Frame>

                <Button Text="{Binding ActionBtnText}" 
                        Command="{Binding ToggleTripCommand}"
                        BackgroundColor="{Binding IsDriving, Converter={StaticResource BooleanToObjectConverter}}" 
                        TextColor="White" 
                        HeightRequest="48" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>