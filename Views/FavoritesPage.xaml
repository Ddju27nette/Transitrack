<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="transitrack.Views.FavoritesPage"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *">

        <!-- Barre de titre -->
        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="18,20,18,16">
            <Label Text="Favoris" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="16,14,16,28">

                <!-- Favori 1 : Rond-point Deïdo -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Rond-point Deïdo" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Grid.Column="1" Text="★" FontSize="18" TextColor="#F59E0B" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border BackgroundColor="#0F766E" StrokeShape="RoundRectangle 6" Padding="6,2" MinimumWidthRequest="38">
                                <Label Text="L12" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="vers Akwa" FontSize="13" TextColor="#334155" Margin="8,0,0,0" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="5–10 min" FontSize="13" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border BackgroundColor="#2563EB" StrokeShape="RoundRectangle 6" Padding="6,2" MinimumWidthRequest="38">
                                <Label Text="L7" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="vers Bonanjo" FontSize="13" TextColor="#334155" Margin="8,0,0,0" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="10–15 min" FontSize="13" FontAttributes="Bold" TextColor="#2563EB" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F1F5F9" />
                        <Label Text="Mis à jour 08:41" FontSize="11" TextColor="#64748B" />
                    </VerticalStackLayout>
                </Border>

                <!-- Favori 2 : Place du Gouvernement, Bonanjo -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Place du Gouvernement, Bonanjo" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Grid.Column="1" Text="★" FontSize="18" TextColor="#F59E0B" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border BackgroundColor="#2563EB" StrokeShape="RoundRectangle 6" Padding="6,2" MinimumWidthRequest="38">
                                <Label Text="L7" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="vers Bonanjo" FontSize="13" TextColor="#334155" Margin="8,0,0,0" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="12–18 min" FontSize="13" FontAttributes="Bold" TextColor="#2563EB" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border BackgroundColor="#D97706" StrokeShape="RoundRectangle 6" Padding="6,2" MinimumWidthRequest="38">
                                <Label Text="L3" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="vers Bonabéri" FontSize="13" TextColor="#334155" Margin="8,0,0,0" VerticalOptions="Center" />
                            <Border Grid.Column="2" BackgroundColor="#FEF3C7" StrokeShape="RoundRectangle 6" Padding="6,2">
                                <Label Text="à confirmer" FontSize="11" TextColor="#B45309" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F1F5F9" />
                        <Label Text="Mis à jour 08:20" FontSize="11" TextColor="#64748B" />
                    </VerticalStackLayout>
                </Border>

                <!-- Favori 3 : Carrefour Akwa -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Carrefour Akwa" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Grid.Column="1" Text="★" FontSize="18" TextColor="#F59E0B" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border BackgroundColor="#0F766E" StrokeShape="RoundRectangle 6" Padding="6,2" MinimumWidthRequest="38">
                                <Label Text="L12" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="vers Akwa" FontSize="13" TextColor="#334155" Margin="8,0,0,0" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="3–6 min" FontSize="13" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F1F5F9" />
                        <Label Text="Mis à jour 08:38" FontSize="11" TextColor="#64748B" />
                    </VerticalStackLayout>
                </Border>

                <!-- Astuce Figma en bas de page -->
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,10,0,0">
                    <Label Text="Ajoutez un arrêt depuis sa fiche" FontSize="12" TextColor="#64748B" HorizontalOptions="Center" />
                    <Label Text="avec l'étoile ★" FontSize="12" TextColor="#64748B" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Bannière connexion -->
                <Border BackgroundColor="#F0FDFA" Stroke="#CCFBF1" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Connectez-vous pour synchroniser vos favoris" FontSize="12" TextColor="#0F766E" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Se connecter →" FontSize="12" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGoToLoginClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>