<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="transitrack.Views.ProfilePage"
             BackgroundColor="#F6F1E4">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="18,24,18,32">

            <Label Text="Profil" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />

            <!-- Avatar vert forêt AK Amina K. -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="20">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 34" BackgroundColor="#114B3E" WidthRequest="68" HeightRequest="68">
                        <Label Text="AK" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Amina K." FontSize="18" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center" />
                        <Label Text="amina@exemple.com" FontSize="13" TextColor="#64748B" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Compteurs : 12 signalements • 9 confirmés • 5 favoris (Figma 09-profil.pdf) -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                <Border Grid.Column="0" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="10">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="12" FontSize="20" FontAttributes="Bold" TextColor="#0F766E" HorizontalOptions="Center" />
                        <Label Text="signalements" FontSize="11" TextColor="#64748B" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="10">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="9" FontSize="20" FontAttributes="Bold" TextColor="#16A34A" HorizontalOptions="Center" />
                        <Label Text="confirmés" FontSize="11" TextColor="#64748B" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="10">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="5" FontSize="20" FontAttributes="Bold" TextColor="#D97706" HorizontalOptions="Center" />
                        <Label Text="favoris" FontSize="11" TextColor="#64748B" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Paramètres Figma -->
            <Label Text="Paramètres" FontSize="15" FontAttributes="Bold" TextColor="#334155" Margin="2,4,0,0" />

            <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*, Auto" Padding="16,13">
                        <Label Text="Localisation" FontSize="14" TextColor="#1E293B" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="›" FontSize="18" TextColor="#94A3B8" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F1F5F9" />

                    <Grid ColumnDefinitions="*, Auto" Padding="16,13">
                        <Label Text="Langue" FontSize="14" TextColor="#1E293B" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Français ›" FontSize="13" TextColor="#64748B" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F1F5F9" />

                    <Grid ColumnDefinitions="*, Auto" Padding="16,13">
                        <Label Text="Mes signalements" FontSize="14" TextColor="#1E293B" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="›" FontSize="18" TextColor="#94A3B8" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F1F5F9" />

                    <Grid ColumnDefinitions="*, Auto" Padding="16,13">
                        <Label Text="Modifier le mot de passe" FontSize="14" TextColor="#1E293B" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="›" FontSize="18" TextColor="#94A3B8" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F1F5F9" />

                    <Grid ColumnDefinitions="*, Auto" Padding="16,13">
                        <Label Text="À propos des estimations" FontSize="14" TextColor="#1E293B" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="›" FontSize="18" TextColor="#94A3B8" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Localisation facultative, utilisée seulement pour les arrêts proches" FontSize="11" TextColor="#64748B" Margin="2,0,0,0" />

            <!-- Déconnexion -->
            <Button Text="Se déconnecter" BackgroundColor="#FEE2E2" TextColor="#DC2626" 
                    FontAttributes="Bold" CornerRadius="8" HeightRequest="46" Margin="0,4,0,0"
                    Clicked="OnLogoutClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>