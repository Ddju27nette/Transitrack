<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="transitrack.Views.ProfilePage"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16,24,16,32">

            <!-- Avatar et Identité Amina K. -->
            <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="#FFFFFF" Padding="20">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border StrokeShape="RoundRectangle 32" BackgroundColor="#CCFBF1" WidthRequest="64" HeightRequest="64">
                        <Label Text="AK" FontSize="20" FontAttributes="Bold" TextColor="#0F766E" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Amina K." FontSize="18" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center" />
                        <Label Text="amina@exemple.com" FontSize="13" TextColor="#64748B" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Statistiques : 12 signalements • 9 confirmés -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <Border Grid.Column="0" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="16">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="12" FontSize="22" FontAttributes="Bold" TextColor="#0F766E" HorizontalOptions="Center" />
                        <Label Text="signalements" FontSize="12" TextColor="#64748B" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="16">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="9" FontSize="22" FontAttributes="Bold" TextColor="#16A34A" HorizontalOptions="Center" />
                        <Label Text="confirmés" FontSize="12" TextColor="#64748B" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Paramètres -->
            <Label Text="Paramètres" FontSize="15" FontAttributes="Bold" TextColor="#334155" Margin="4,8,0,0" />

            <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16" BackgroundColor="#FFFFFF" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*, Auto" Padding="16,14">
                        <Label Text="Localisation" FontSize="14" TextColor="#1E293B" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="›" FontSize="20" TextColor="#94A3B8" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F1F5F9" />

                    <Grid ColumnDefinitions="*, Auto" Padding="16,14">
                        <Label Text="Langue" FontSize="14" TextColor="#1E293B" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="›" FontSize="20" TextColor="#94A3B8" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F1F5F9" />

                    <Grid ColumnDefinitions="*, Auto" Padding="16,14">
                        <Label Text="Mes signalements" FontSize="14" TextColor="#1E293B" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="›" FontSize="20" TextColor="#94A3B8" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F1F5F9" />

                    <Grid ColumnDefinitions="*, Auto" Padding="16,14">
                        <Label Text="Modifier le mot de passe" FontSize="14" TextColor="#1E293B" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="›" FontSize="20" TextColor="#94A3B8" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Bouton Déconnexion -->
            <Button Text="Se déconnecter" BackgroundColor="#FEE2E2" TextColor="#DC2626" 
                    FontAttributes="Bold" CornerRadius="12" HeightRequest="46" Margin="0,4,0,0"
                    Clicked="OnLogoutClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>