<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="transitrack.Views.AuthPage"
             BackgroundColor="#FFFFFF">

    <ScrollView>
        <VerticalStackLayout Spacing="22" Padding="24,40,24,32" MaximumWidthRequest="420" HorizontalOptions="Center">

            <!-- En-tête Figma : Connexion -->
            <VerticalStackLayout Spacing="6" Margin="0,10,0,8">
                <Label x:Name="LblTitle" Text="Connexion" FontSize="26" FontAttributes="Bold" TextColor="#0F172A" />
                <Label Text="Contribuez et synchronisez vos favoris." FontSize="14" TextColor="#64748B" />
            </VerticalStackLayout>

            <!-- Champ Nom d'utilisateur (Visible uniquement en mode Inscription) -->
            <VerticalStackLayout x:Name="FieldUsername" Spacing="6" IsVisible="False">
                <Label Text="Nom d'utilisateur" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#FFFFFF" Padding="14,0">
                    <Entry Placeholder="amina_k" FontSize="14" HeightRequest="48" TextColor="#0F172A" />
                </Border>
            </VerticalStackLayout>

            <!-- Champ Adresse e-mail -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Adresse e-mail" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#FFFFFF" Padding="14,0">
                    <Entry x:Name="TxtEmail" Placeholder="nom@exemple.com" Keyboard="Email" FontSize="14" HeightRequest="48" TextColor="#0F172A" />
                </Border>
            </VerticalStackLayout>

            <!-- Champ Mot de passe -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Mot de passe" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#FFFFFF" Padding="14,0">
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry x:Name="TxtPassword" IsPassword="True" Placeholder="••••••••" FontSize="14" HeightRequest="48" TextColor="#0F172A" />
                        <Label x:Name="LblTogglePwd" Grid.Column="1" Text="Afficher" FontSize="13" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center" Margin="8,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTogglePasswordClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Mot de passe oublié ? -->
            <Label x:Name="LblForgotPassword" Text="Mot de passe oublié ?" FontSize="13" TextColor="#0F766E" HorizontalOptions="Start">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnForgotPasswordClicked" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Bouton Se connecter -->
            <Button x:Name="BtnMainSubmit" Text="Se connecter" BackgroundColor="#0F766E" TextColor="#FFFFFF" 
                    FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Margin="0,4,0,0"
                    Clicked="OnSubmitClicked" />

            <!-- Séparateur 'ou' -->
            <Grid ColumnDefinitions="*, Auto, *" VerticalOptions="Center" Margin="0,4">
                <BoxView Grid.Column="0" HeightRequest="1" Color="#E2E8F0" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="ou" FontSize="13" TextColor="#94A3B8" Margin="14,0" VerticalOptions="Center" />
                <BoxView Grid.Column="2" HeightRequest="1" Color="#E2E8F0" VerticalOptions="Center" />
            </Grid>

            <!-- Bouton Créer un compte -->
            <Button x:Name="BtnSecondaryAction" Text="Créer un compte" BackgroundColor="#FFFFFF" TextColor="#0F172A" 
                    BorderColor="#CBD5E1" BorderWidth="1" FontAttributes="Bold" CornerRadius="8" HeightRequest="48"
                    Clicked="OnSwitchModeClicked" />

            <!-- Lien Continuer sans compte + Mentions -->
            <VerticalStackLayout Spacing="4" Margin="0,6,0,0">
                <Button Text="Continuer sans compte" BackgroundColor="Transparent" TextColor="#0F766E" 
                        FontSize="14" FontAttributes="Bold" Clicked="OnContinueWithoutAccountClicked" />
                <Label Text="Un compte n'est nécessaire que pour contribuer." FontSize="12" TextColor="#64748B" HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>