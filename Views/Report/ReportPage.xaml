<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransiTrack.ViewModels"
             x:Class="TransiTrack.Views.Report.ReportPage"
             Title="Signaler un Problème"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Signalement anonyme &amp; direct" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
            <Label Text="Aucune inscription requise. Signalez un ralentissement ou un embouteillage pour mettre à jour les temps d'arrivée estimés." 
                   FontSize="13" TextColor="{StaticResource TextSecondary}" />

            <BoxView HeightRequest="1" Color="#DEE2E6" Margin="0,4" />

            <Label Text="Nature du problème" FontAttributes="Bold" />
            <Border Stroke="#DEE2E6" StrokeShape="RoundRectangle 10" Padding="10,0" BackgroundColor="White">
                <Picker ItemsSource="{Binding IncidentTypes}" SelectedItem="{Binding SelectedType}" HeightRequest="46" />
            </Border>

            <Label Text="Lieu ou Carrefour concerné" FontAttributes="Bold" />
            <Border Stroke="#DEE2E6" StrokeShape="RoundRectangle 10" Padding="12,2" BackgroundColor="White">
                <Entry Placeholder="Ex: Rond-Point Ndokoti" Text="{Binding LocationName}" HeightRequest="46" />
            </Border>

            <Label Text="Détails complémentaires (optionnel)" FontAttributes="Bold" />
            <Border Stroke="#DEE2E6" StrokeShape="RoundRectangle 10" Padding="12,6" BackgroundColor="White">
                <Editor Placeholder="Ex: File de voitures bloquée dans les deux sens..." Text="{Binding Description}" HeightRequest="100" />
            </Border>

            <Button Text="Diffuser le signalement" Command="{Binding SubmitReportCommand}" 
                    Style="{StaticResource PrimaryBtnStyle}" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>