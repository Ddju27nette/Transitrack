<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransiTrack.ViewModels"
             xmlns:models="clr-namespace:TransiTrack.Models"
             x:Class="TransiTrack.Views.History.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="Historique des Trajets"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto,*" Padding="16">
        <Label Text="Vos déplacements récents" FontSize="18" FontAttributes="Bold" Margin="0,0,0,12" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Trips}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TripHistory">
                    <Border Margin="0,0,0,10" Padding="14" StrokeShape="RoundRectangle 12" BackgroundColor="White" StrokeThickness="0">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding DateFormatted}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                <Label Grid.Column="1" Text="{Binding LineUsed, StringFormat='Ligne {0}'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                            </Grid>
                            <Label Text="{Binding Origin, StringFormat='{0} ➔ '}" FontAttributes="Bold" FontSize="15">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Origin}" FontAttributes="Bold" />
                                        <Span Text=" ➔ " TextColor="{StaticResource PrimaryColor}" />
                                        <Span Text="{Binding Destination}" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="{Binding Duration, StringFormat='Durée : {0}'}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>