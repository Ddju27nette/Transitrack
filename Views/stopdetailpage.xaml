<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="transitrack.Views.StopDetailPage"
             BackgroundColor="#F6F1E4">

    <Grid RowDefinitions="Auto, *">

        <!-- Barre de titre simple avec bouton retour -->
        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="16,14">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Button Text="‹" FontSize="26" BackgroundColor="Transparent" TextColor="#0F766E" Padding="0" Clicked="OnBackClicked" />
                <Label Text="9:41" Grid.Column="1" HorizontalOptions="Center" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                <Label Text="★" Grid.Column="2" FontSize="20" TextColor="#F59E0B" VerticalOptions="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="16,14,16,28">

                <!-- En-tête Arrêt -->
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="LblStopTitle" Text="Rond-point Deïdo" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="Arrêt • 120 m" FontSize="13" TextColor="#64748B" />
                </VerticalStackLayout>

                <!-- Ligne 12 • Fiable -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border BackgroundColor="#0F766E" StrokeShape="RoundRectangle 6" Padding="6,2" MinimumWidthRequest="40">
                                <Label Text="L12" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="11" HorizontalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="vers Akwa" FontSize="14" TextColor="#1E293B" FontAttributes="Bold" Margin="10,0,0,0" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="5–10 min" FontSize="15" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *">
                            <Border BackgroundColor="#DCFCE7" StrokeShape="RoundRectangle 6" Padding="6,2">
                                <Label Text="Fiable" FontSize="11" TextColor="#15803D" FontAttributes="Bold" />
                            </Border>
                            <Label Grid.Column="1" Text="Mis à jour il y a 2 min • 3 confirmations" FontSize="11" TextColor="#64748B" Margin="8,0,0,0" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Ligne 7 • À confirmer -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border BackgroundColor="#2563EB" StrokeShape="RoundRectangle 6" Padding="6,2" MinimumWidthRequest="40">
                                <Label Text="L7" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="11" HorizontalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="vers Bonanjo" FontSize="14" TextColor="#1E293B" FontAttributes="Bold" Margin="10,0,0,0" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="10–15 min" FontSize="15" FontAttributes="Bold" TextColor="#2563EB" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *">
                            <Border BackgroundColor="#FEF3C7" StrokeShape="RoundRectangle 6" Padding="6,2">
                                <Label Text="À confirmer" FontSize="11" TextColor="#B45309" FontAttributes="Bold" />
                            </Border>
                            <Label Grid.Column="1" Text="Mis à jour il y a 9 min • 1 confirmation" FontSize="11" TextColor="#64748B" Margin="8,0,0,0" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Ligne 3 • Information ancienne -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border BackgroundColor="#D97706" StrokeShape="RoundRectangle 6" Padding="6,2" MinimumWidthRequest="40">
                                <Label Text="L3" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="11" HorizontalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="vers Bonabéri" FontSize="14" TextColor="#1E293B" FontAttributes="Bold" Margin="10,0,0,0" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="—" FontSize="15" FontAttributes="Bold" TextColor="#94A3B8" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *">
                            <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 6" Padding="6,2">
                                <Label Text="Information ancienne" FontSize="11" TextColor="#64748B" />
                            </Border>
                            <Label Grid.Column="1" Text="Dernier signalement il y a 47 min" FontSize="11" TextColor="#94A3B8" Margin="8,0,0,0" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Graphique Figma d'attente moyenne (05-arret-passages.pdf) -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Attente moyenne ici, aujourd'hui" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" />

                        <!-- Histogramme bâtons reproduit de Figma -->
                        <Grid ColumnDefinitions="*,*,*,*,*,*" HeightRequest="70" VerticalOptions="End">
                            <BoxView Grid.Column="0" BackgroundColor="#CCFBF1" WidthRequest="22" HeightRequest="30" VerticalOptions="End" HorizontalOptions="Center" CornerRadius="4" />
                            <BoxView Grid.Column="1" BackgroundColor="#CCFBF1" WidthRequest="22" HeightRequest="65" VerticalOptions="End" HorizontalOptions="Center" CornerRadius="4" />
                            <BoxView Grid.Column="2" BackgroundColor="#CCFBF1" WidthRequest="22" HeightRequest="35" VerticalOptions="End" HorizontalOptions="Center" CornerRadius="4" />
                            <BoxView Grid.Column="3" BackgroundColor="#CCFBF1" WidthRequest="22" HeightRequest="45" VerticalOptions="End" HorizontalOptions="Center" CornerRadius="4" />
                            <BoxView Grid.Column="4" BackgroundColor="#F97316" WidthRequest="22" HeightRequest="70" VerticalOptions="End" HorizontalOptions="Center" CornerRadius="4" />
                            <BoxView Grid.Column="5" BackgroundColor="#CCFBF1" WidthRequest="22" HeightRequest="25" VerticalOptions="End" HorizontalOptions="Center" CornerRadius="4" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*,*,*,*">
                            <Label Text="6h" Grid.Column="0" FontSize="10" TextColor="#64748B" HorizontalOptions="Center" />
                            <Label Text="9h" Grid.Column="1" FontSize="10" TextColor="#64748B" HorizontalOptions="Center" />
                            <Label Text="12h" Grid.Column="2" FontSize="10" TextColor="#64748B" HorizontalOptions="Center" />
                            <Label Text="14h" Grid.Column="3" FontSize="10" TextColor="#64748B" HorizontalOptions="Center" />
                            <Label Text="17h" Grid.Column="4" FontSize="10" FontAttributes="Bold" TextColor="#EA580C" HorizontalOptions="Center" />
                            <Label Text="20h" Grid.Column="5" FontSize="10" TextColor="#64748B" HorizontalOptions="Center" />
                        </Grid>

                        <Label Text="Environ 11 min en ce moment, d'après 46 signalements" FontSize="11" TextColor="#64748B" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- Boutons d'actions Figma -->
                <Button Text="Signaler le passage d'un bus" BackgroundColor="#0F766E" TextColor="#FFFFFF" 
                        FontAttributes="Bold" CornerRadius="8" HeightRequest="48" Margin="0,4,0,0"
                        Clicked="OnReportBusClicked" />

                <Button Text="Actualiser" BackgroundColor="#FFFFFF" TextColor="#0F172A" BorderColor="#CBD5E1" BorderWidth="1"
                        FontAttributes="Bold" CornerRadius="8" HeightRequest="46" Clicked="OnRefreshClicked" />

                <!-- Voir l'historique de l'arrêt -->
                <Label Text="Voir l'historique de l'arrêt ›" FontSize="13" FontAttributes="Bold" TextColor="#0F766E" HorizontalOptions="Center" Margin="0,4,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnViewHistoryClicked" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Mentions légales en bas -->
                <VerticalStackLayout Spacing="2" Margin="0,8,0,0">
                    <Label Text="Estimation communautaire, pas une garantie." FontSize="11" TextColor="#64748B" HorizontalOptions="Center" />
                    <Label Text="Les observations de plus de 20 min sont signalées." FontSize="11" TextColor="#64748B" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>