<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="transitrack.Views.ReportsPage"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" BackgroundColor="#0F766E" Padding="20,24,20,16">
            <Label Text="Incidents et Trafic" FontSize="20" FontAttributes="Bold" TextColor="White" />
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="16,18,16,24">

                <!-- Alerte 1 -->
                <Border Stroke="#FCD34D" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFBEB" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="⚠️ Embouteillage sévère" FontSize="15" FontAttributes="Bold" TextColor="#B45309" />
                            <Label Grid.Column="1" Text="Il y a 10 min" FontSize="11" TextColor="#78350F" />
                        </Grid>
                        <Label Text="Axe Carrefour Ndokoti : Travaux d'urgence sur la voie de bus. Retards de 20 minutes à prévoir sur les lignes 2 et 5." 
                               FontSize="13" TextColor="#451A03" />
                    </VerticalStackLayout>
                </Border>

                <!-- Alerte 2 -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="🚧 Déviation de ligne" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Grid.Column="1" Text="Il y a 35 min" FontSize="11" TextColor="#64748B" />
                        </Grid>
                        <Label Text="Ligne 1 : L'arrêt Marché Central est temporairement déplacé 150 mètres plus loin vers la rue Joss." 
                               FontSize="13" TextColor="#475569" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>