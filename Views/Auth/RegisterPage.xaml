<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransiTrack.ViewModels"
             x:Class="TransiTrack.Views.Auth.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Créer un compte"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Rejoignez TransiTrack" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
            <Label Text="Créez un compte pour suivre vos bus en temps réel et enregistrer vos lignes régulières." 
                   FontSize="14" TextColor="{StaticResource TextSecondary}" />

            <BoxView HeightRequest="8" Color="Transparent" />

            <Label Text="Nom complet" FontAttributes="Bold" FontSize="14" />
            <Border Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 10" Padding="12,2" BackgroundColor="White">
                <Entry Placeholder="Ex: Dorcas Ambo'o" Text="{Binding FullName}" Style="{StaticResource StandardEntryStyle}" />
            </Border>

            <Label Text="Adresse e-mail" FontAttributes="Bold" FontSize="14" />
            <Border Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 10" Padding="12,2" BackgroundColor="White">
                <Entry Placeholder="Ex: utilisateur@mail.cm" Text="{Binding Email}" Keyboard="Email" Style="{StaticResource StandardEntryStyle}" />
            </Border>

            <Label Text="Numéro de téléphone" FontAttributes="Bold" FontSize="14" />
            <Border Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 10" Padding="12,2" BackgroundColor="White">
                <Entry Placeholder="Ex: +237 6XX XX XX XX" Text="{Binding PhoneNumber}" Keyboard="Telephone" Style="{StaticResource StandardEntryStyle}" />
            </Border>

            <Label Text="Mot de passe" FontAttributes="Bold" FontSize="14" />
            <Border Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 10" Padding="12,2" BackgroundColor="White">
                <Entry Placeholder="Minimum 6 caractères" Text="{Binding Password}" IsPassword="True" Style="{StaticResource StandardEntryStyle}" />
            </Border>

            <Button Text="Finaliser l'inscription" Command="{Binding RegisterCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,20,0,0" />

            <Button Text="Déjà un compte ? Se connecter" Command="{Binding BackToLoginCommand}" 
                    BackgroundColor="Transparent" TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>