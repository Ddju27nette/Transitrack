<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TransiTrack.ViewModels"
             x:Class="TransiTrack.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="20" VerticalOptions="Center">
            <!-- Logo & Entête -->
            <Border StrokeThickness="0" BackgroundColor="{StaticResource PrimaryColor}" 
                    StrokeShape="RoundRectangle 24" HeightRequest="80" WidthRequest="80" HorizontalOptions="Center">
                <Label Text="🚌" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="TransiTrack" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource PrimaryColor}" />
            <Label Text="Connectez-vous à votre espace voyageur" FontSize="14" HorizontalOptions="Center" TextColor="{StaticResource TextSecondary}" />

            <BoxView HeightRequest="10" Color="Transparent" />

            <!-- Formulaire -->
            <Border Stroke="{StaticResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="14,2" BackgroundColor="White">
                <Entry Placeholder="Adresse email" Text="{Binding Email}" Keyboard="Email" Style="{StaticResource StandardEntryStyle}" />
            </Border>

            <Border Stroke="{StaticResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="14,2" BackgroundColor="White">
                <Entry Placeholder="Mot de passe" Text="{Binding Password}" IsPassword="True" Style="{StaticResource StandardEntryStyle}" />
            </Border>

            <Button Text="Se connecter" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0" />

            <!-- Lien Inscription -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,20,0,0">
                <Label Text="Pas encore de compte ?" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                <Button Text="S'inscrire" Command="{Binding GoToRegisterCommand}" 
                        BackgroundColor="Transparent" TextColor="{StaticResource PrimaryColor}" FontAttributes="Bold" Padding="0" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>