<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="transitrack.Views.HomeStopsPage"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *">

        <!-- En-tête vert foncé Figma -->
        <Border Grid.Row="0" BackgroundColor="#0F766E" StrokeThickness="0" Padding="18,24,18,20">
            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="3">
                    <Label Text="TransiTrack" FontSize="22" FontAttributes="Bold" TextColor="#FFFFFF" />
                    <Label Text="Où attendez-vous le bus ?" FontSize="14" TextColor="#CCFBF1" />
                </VerticalStackLayout>

                <!-- Champ de recherche blanc -->
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" BackgroundColor="#FFFFFF" Padding="12,0">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Grid.Column="0" Text="🔍" FontSize="14" TextColor="#64748B" VerticalOptions="Center" Margin="0,0,10,0" />
                        <Entry Grid.Column="1" Placeholder="Rechercher un arrêt" PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="14" HeightRequest="44" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- Liste des arrêts et bannières -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="16,16,16,32">

                <!-- Section Titre + Localisation facultative -->
                <Grid ColumnDefinitions="*, Auto" Margin="2,0,2,2">
                    <Label Text="Arrêts proches" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Localisation facultative" FontSize="11" TextColor="#64748B" VerticalOptions="Center" />
                </Grid>

                <!-- Carte Arrêt 1 : Rond-point Deïdo -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStopCardClicked" CommandParameter="Rond-point Deïdo" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Rond-point Deïdo" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Grid.Column="1" Text="120 m" FontSize="12" TextColor="#64748B" />
                        </Grid>

                        <!-- L12 vers Akwa -->
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border BackgroundColor="#0F766E" StrokeShape="RoundRectangle 6" Padding="6,2" MinimumWidthRequest="38">
                                <Label Text="L12" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="vers Akwa" FontSize="13" TextColor="#334155" Margin="8,0,0,0" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="5–10 min" FontSize="13" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center" />
                        </Grid>

                        <!-- L7 vers Bonanjo -->
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border BackgroundColor="#2563EB" StrokeShape="RoundRectangle 6" Padding="6,2" MinimumWidthRequest="38">
                                <Label Text="L7" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="vers Bonanjo" FontSize="13" TextColor="#334155" Margin="8,0,0,0" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="10–15 min" FontSize="13" FontAttributes="Bold" TextColor="#2563EB" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,2,0,2" />
                        <Label Text="Mis à jour 08:41 • 3 confirmations récentes" FontSize="11" TextColor="#16A34A" />
                    </VerticalStackLayout>
                </Border>

                <!-- Carte Arrêt 2 : Marché New Bell -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStopCardClicked" CommandParameter="Marché New Bell" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Marché New Bell" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Grid.Column="1" Text="340 m" FontSize="12" TextColor="#64748B" />
                        </Grid>

                        <!-- L3 vers Bonabéri -->
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border BackgroundColor="#D97706" StrokeShape="RoundRectangle 6" Padding="6,2" MinimumWidthRequest="38">
                                <Label Text="L3" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="vers Bonabéri" FontSize="13" TextColor="#334155" Margin="8,0,0,0" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="12 min" FontSize="13" FontAttributes="Bold" TextColor="#D97706" VerticalOptions="Center" />
                        </Grid>

                        <!-- L12 vers Deïdo -->
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border BackgroundColor="#0F766E" StrokeShape="RoundRectangle 6" Padding="6,2" MinimumWidthRequest="38">
                                <Label Text="L12" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="vers Deïdo" FontSize="13" TextColor="#334155" Margin="8,0,0,0" VerticalOptions="Center" />
                            <Border Grid.Column="2" BackgroundColor="#FEF3C7" StrokeShape="RoundRectangle 6" Padding="6,2">
                                <Label Text="À confirmer" FontSize="11" TextColor="#B45309" FontAttributes="Bold" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,2,0,2" />
                        <Label Text="Mis à jour 08:35 • 1 confirmation" FontSize="11" TextColor="#64748B" />
                    </VerticalStackLayout>
                </Border>

                <!-- Carte Arrêt 3 : Carrefour Akwa -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStopCardClicked" CommandParameter="Carrefour Akwa" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Carrefour Akwa" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Grid.Column="1" Text="450 m" FontSize="12" TextColor="#64748B" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border BackgroundColor="#0F766E" StrokeShape="RoundRectangle 6" Padding="6,2" MinimumWidthRequest="38">
                                <Label Text="L12" FontSize="12" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Text="vers Akwa" FontSize="13" TextColor="#334155" Margin="8,0,0,0" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="3–6 min" FontSize="13" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,2,0,2" />
                        <Label Text="Mis à jour 08:38" FontSize="11" TextColor="#64748B" />
                    </VerticalStackLayout>
                </Border>

                <!-- Encadré Incitatif Figma : Synchronisation des favoris -->
                <Border BackgroundColor="#F0FDFA" Stroke="#CCFBF1" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14" Margin="0,6,0,0">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Connectez-vous pour synchroniser vos favoris" FontSize="12" TextColor="#0F766E" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Se connecter →" FontSize="12" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGoToLoginClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>