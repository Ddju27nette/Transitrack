<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="transitrack.Views.HistoryPage"
             BackgroundColor="#F6F1E4">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Barre de titre + Arrêt + Message vert Figma -->
        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="18,18,18,14">
            <VerticalStackLayout Spacing="6">
                <Button Text="← Retour" BackgroundColor="Transparent" TextColor="#0F766E" 
                        FontAttributes="Bold" HorizontalOptions="Start" Padding="0" Clicked="OnBackClicked" />
                <Label Text="Historique" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                <Label Text="Rond-point Deïdo" FontSize="14" TextColor="#64748B" />
                <Label Text="Signalement enregistré, merci !" FontSize="12" FontAttributes="Bold" TextColor="#16A34A" Margin="0,2,0,0" />
            </VerticalStackLayout>
        </Border>

        <!-- Filtres horizontaux Toutes, L12, L7, L3 -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,8,0,10">
            <HorizontalStackLayout Spacing="8" Padding="16,0">
                <Border BackgroundColor="#0F766E" StrokeShape="RoundRectangle 18" Padding="16,8">
                    <Label Text="Toutes" TextColor="#FFFFFF" FontSize="13" FontAttributes="Bold" />
                </Border>
                <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16,8">
                    <Label Text="L12" TextColor="#475569" FontSize="13" FontAttributes="Bold" />
                </Border>
                <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16,8">
                    <Label Text="L7" TextColor="#475569" FontSize="13" FontAttributes="Bold" />
                </Border>
                <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16,8">
                    <Label Text="L3" TextColor="#475569" FontSize="13" FontAttributes="Bold" />
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Liste des flux d'historique -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="12" Padding="16,4,16,28">

                <!-- 08:41 - Fiable - x3 -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="08:41" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" />
                            <Border BackgroundColor="#DCFCE7" StrokeShape="RoundRectangle 6" Padding="6,2">
                                <Label Text="Fiable" FontSize="11" TextColor="#15803D" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                        <Label Text="Ligne 12 vers Akwa" FontSize="14" FontAttributes="Bold" TextColor="#334155" />
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="il y a 2 min" FontSize="11" TextColor="#64748B" />
                            <Label Grid.Column="1" Text="x3" FontSize="12" FontAttributes="Bold" TextColor="#0F766E" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 08:32 - À confirmer - x1 -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="08:32" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" />
                            <Border BackgroundColor="#FEF3C7" StrokeShape="RoundRectangle 6" Padding="6,2">
                                <Label Text="À confirmer" FontSize="11" TextColor="#B45309" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                        <Label Text="Ligne 7. vers Bonanjo" FontSize="14" FontAttributes="Bold" TextColor="#334155" />
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="il y a 11 min" FontSize="11" TextColor="#64748B" />
                            <Label Grid.Column="1" Text="x1" FontSize="12" FontAttributes="Bold" TextColor="#D97706" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 07:58 - Information ancienne - expiré -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="07:58" FontSize="13" FontAttributes="Bold" TextColor="#94A3B8" />
                            <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 6" Padding="6,2">
                                <Label Text="Information ancienne" FontSize="11" TextColor="#64748B" />
                            </Border>
                        </Grid>
                        <Label Text="Ligne 12 vers Akwa" FontSize="14" FontAttributes="Bold" TextColor="#64748B" />
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="il y a 45 min" FontSize="11" TextColor="#94A3B8" />
                            <Label Grid.Column="1" Text="expiré" FontSize="11" TextColor="#94A3B8" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 07:40 - Information ancienne - expiré -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="07:40" FontSize="13" FontAttributes="Bold" TextColor="#94A3B8" />
                            <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 6" Padding="6,2">
                                <Label Text="Information ancienne" FontSize="11" TextColor="#64748B" />
                            </Border>
                        </Grid>
                        <Label Text="Ligne 3 vers Bonabéri" FontSize="14" FontAttributes="Bold" TextColor="#64748B" />
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="il y a 1 h 03" FontSize="11" TextColor="#94A3B8" />
                            <Label Grid.Column="1" Text="expiré" FontSize="11" TextColor="#94A3B8" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>