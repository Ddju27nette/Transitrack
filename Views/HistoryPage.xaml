<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="transitrack.Views.HistoryPage"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Barre de titre + Nom d'arrêt -->
        <Border Grid.Row="0" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="18,18,18,14">
            <VerticalStackLayout Spacing="6">
                <Button Text="← Retour" BackgroundColor="Transparent" TextColor="#0F766E" 
                        FontAttributes="Bold" HorizontalOptions="Start" Padding="0" Clicked="OnBackClicked" />
                <Label Text="Historique" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                <Label Text="Rond-point Deïdo" FontSize="14" TextColor="#64748B" />
                <Label Text="✓ Signalement enregistré, merci !" FontSize="12" FontAttributes="Bold" TextColor="#16A34A" Margin="0,2,0,0" />
            </VerticalStackLayout>
        </Border>

        <!-- Filtres horizontaux Toutes, L12, L7, L3 -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,8,0,10">
            <HorizontalStackLayout Spacing="8" Padding="16,0">
                <Border BackgroundColor="#0F766E" StrokeShape="RoundRectangle 18" Padding="16,8">
                    <Label Text="Toutes" TextColor="#FFFFFF" FontSize="13" FontAttributes="Bold" />
                </Border>
                <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16,8">
                    <Label Text="L12" TextColor="#475569" FontSize="13" FontAttributes="Bold" />
                </Border>
                <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16,8">
                    <Label Text="L7" TextColor="#475569" FontSize="13" FontAttributes="Bold" />
                </Border>
                <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="16,8">
                    <Label Text="L3" TextColor="#475569" FontSize="13" FontAttributes="Bold" />
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Liste des flux d'historique -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="12" Padding="16,4,16,28">

                <!-- Entrée 1 : 08:41 - Fiable - x3 -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="08:41 • il y a 2 min" FontSize="12" TextColor="#64748B" />
                            <Border BackgroundColor="#DCFCE7" StrokeShape="RoundRectangle 6" Padding="6,2">
                                <Label Text="Fiable" FontSize="11" TextColor="#15803D" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                        <Label Text="Ligne 12 • vers Akwa" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="✓ ×3 confirmations" FontSize="12" TextColor="#0F766E" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <!-- Entrée 2 : 08:32 - À confirmer - x1 -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="08:32 • il y a 11 min" FontSize="12" TextColor="#64748B" />
                            <Border BackgroundColor="#FEF3C7" StrokeShape="RoundRectangle 6" Padding="6,2">
                                <Label Text="À confirmer" FontSize="11" TextColor="#B45309" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                        <Label Text="Ligne 7 • vers Bonanjo" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="✓ ×1 confirmation" FontSize="12" TextColor="#D97706" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <!-- Entrée 3 : 07:58 - Information ancienne - expiré -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="07:58 • il y a 45 min" FontSize="12" TextColor="#94A3B8" />
                            <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 6" Padding="6,2">
                                <Label Text="Information ancienne" FontSize="11" TextColor="#64748B" />
                            </Border>
                        </Grid>
                        <Label Text="Ligne 12 • vers Akwa" FontSize="15" FontAttributes="Bold" TextColor="#64748B" />
                        <Label Text="expiré" FontSize="11" TextColor="#94A3B8" />
                    </VerticalStackLayout>
                </Border>

                <!-- Entrée 4 : 07:40 - Information ancienne - expiré -->
                <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="07:40 • il y a 1 h 03" FontSize="12" TextColor="#94A3B8" />
                            <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 6" Padding="6,2">
                                <Label Text="Information ancienne" FontSize="11" TextColor="#64748B" />
                            </Border>
                        </Grid>
                        <Label Text="Ligne 3 • vers Bonabéri" FontSize="15" FontAttributes="Bold" TextColor="#64748B" />
                        <Label Text="expiré" FontSize="11" TextColor="#94A3B8" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>